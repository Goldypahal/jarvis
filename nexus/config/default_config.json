{
  "nexus": {
    "version": "0.1.0",
    "debug": false,
    "log_level": "INFO",
    "memory": {
      "db_path": "nexus_memory.db",
      "auto_consolidate": true,
      "consolidation_interval_hours": 24
    },
    "context": {
      "max_history_length": 100,
      "update_on_every_interaction": true
    },
    "reasoning": {
      "system1_response_limit": 150,
      "system2_timeout_seconds": 10
    },
    "specialized_modes": {
      "auto_suggest": true,
      "conflict_resolution": "deactivate_conflicting"
    }
  }
}